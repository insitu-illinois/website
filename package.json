{
  "name": "insitu-illinois-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "node scripts/generate-cms.mjs && node scripts/validate-content.mjs && astro build",
    "preview": "astro preview --host 127.0.0.1",
    "check": "astro check",
    "test": "node --test tests/*.test.mjs",
    "deploy": "npm run build && node scripts/deploy-lab.mjs"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.12",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/source-sans-3": "5.3.1",
    "@fontsource/space-grotesk": "5.3.0",
    "astro": "^7.4.2",
    "marked": "^18.1.1",
    "sanitize-html": "^2.18.1",
    "three": "0.186.1",
    "typescript": "^6.0.3",
    "wrangler": "^4.152.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "overrides": {
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/sanitize-html": "^2.16.2"
  }
}
