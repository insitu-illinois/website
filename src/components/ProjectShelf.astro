---
import GameCase from './GameCase.astro';
import Media from './Media.astro';
const {projects,data}=Astro.props;
const rid=(ref:any):string=>typeof ref==='string'?ref:ref?.id;
const themeName=(id:string)=>data?.themes?.find((t:any)=>t.id===id);
const personName=(id:string)=>data?.people?.find((x:any)=>x.id===id)?.data.name;
const icons:Record<string,string>={'xr-us-museums':`<svg viewBox="0 0 32 32" fill="none" stroke="url(#ig)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path fill="url(#ig)" fill-opacity=".16" d="M3 12.500L16 5l13 7.500z"/><path d="M6 15v9M12 15v9M20 15v9M26 15v9M4 26.500h24"/></svg>`,'game-accessibility':`<svg viewBox="0 0 32 32" fill="none" stroke="url(#ig)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path fill="url(#ig)" fill-opacity=".16" d="M9 11h14a6 6 0 0 1 6 6l-1.500 6a3 3 0 0 1-5 1l-2-3h-9l-2 3a3 3 0 0 1-5-1L3 17a6 6 0 0 1 6-6z"/><circle cx="16" cy="14" r="1.300"/><path d="M12.500 17h7M16 17v3"/><path d="M8 14v4M6 16h4M23 15.500v.01M25.500 18v.01"/></svg>`,'ai-xr-language':`<svg viewBox="0 0 32 32" fill="none" stroke="url(#ig)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path fill="url(#ig)" fill-opacity=".16" d="M5 8h15a3 3 0 0 1 3 3v6a3 3 0 0 1-3 3h-6l-5 4v-4H8a3 3 0 0 1-3-3v-6a3 3 0 0 1 3-3z"/><path d="M10 13h8M10 16.500h5"/><path d="M25 3l1 2.500 2.500 1-2.500 1-1 2.500-1-2.500-2.500-1 2.500-1z"/></svg>`};
const fallbackIcon=`<svg viewBox="0 0 32 32" fill="none" stroke="url(#ig)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path fill="url(#ig)" fill-opacity=".16" d="M16 3l11 6v14l-11 6L5 23V9z"/><path d="M16 3v13M5 9l11 7 11-7M16 16v13"/></svg>`;
---
<div class="project-shelf" data-project-shelf>
  <div class="shelf-panels">
    {projects.map((p:any)=><article class="shelf-panel feature-project" id={`shelf-${p.id}`} aria-labelledby={`shelf-title-${p.id}`} data-project-panel={p.id}>
      <div class="shelf-visual">
        {p.id==='vrchaeology'&&p.data.heroMedia&&p.data.gallery?.length?<GameCase cover={p.data.heroMedia} images={p.data.gallery} name={p.data.name} description={p.data.shortDescription} credits={p.data.credits||[]} creditsHref={`/projects/${p.id}/#credits-heading`} galleryHref={`/projects/${p.id}/#gallery-heading`}/>:p.data.heroMedia?<Media media={p.data.heroMedia} natural/>:<div class="shelf-symbol" aria-hidden="true" set:html={icons[p.id]||fallbackIcon}/>}
      </div>
      <div class="shelf-copy"><p class="label">{p.id==='vrchaeology'?'Flagship project · ':''}{p.data.status==='active'?'Active project':'Completed project'}</p><div class="shelf-titlerow"><h3 id={`shelf-title-${p.id}`}>{p.data.name}</h3>{(p.data.themes||[]).length>0&&<ul class="shelf-meta" aria-label="Research themes">{p.data.themes.map(rid).map((id:string)=>themeName(id)&&<li><a href={`/themes/${id}/`}>{themeName(id).data.name}</a></li>)}</ul>}</div>{p.data.shortDescription&&<p>{p.data.shortDescription}</p>}{(p.data.team||[]).length>0&&<p class="shelf-team"><span>Team</span>{p.data.team.map(rid).map(personName).filter(Boolean).slice(0,4).join(' · ')}{p.data.team.length>4?` · +${p.data.team.length-4} more`:''}</p>}<a class="button" href={`/projects/${p.id}/`}>View project <span aria-hidden="true">↗</span></a></div>
    </article>)}
  </div>
  <div class="shelf-picker" role="group" aria-label="Choose a project" hidden>
    {projects.map((p:any,i:number)=><button type="button" data-project-choice={p.id} aria-controls={`shelf-${p.id}`} aria-pressed={i===0?'true':'false'}><span class="shelf-thumb" aria-hidden="true">{p.data.heroMedia?<img src={p.data.heroMedia.src} alt="" width="64" height="64"/>:<span set:html={icons[p.id]||fallbackIcon}/>}</span><span class="shelf-item-copy"><strong>{p.data.name}</strong><span>{p.data.status==='active'?'Active project':'Completed project'}</span></span><span class="shelf-indicator" aria-hidden="true">↗</span></button>)}
  </div>
  <p class="visually-hidden" data-shelf-status role="status"></p>
</div>
<script>
for(const shelf of document.querySelectorAll<HTMLElement>('[data-project-shelf]')){
 const panels=Array.from(shelf.querySelectorAll<HTMLElement>('[data-project-panel]'));
 const buttons=Array.from(shelf.querySelectorAll<HTMLButtonElement>('[data-project-choice]'));
 const picker=shelf.querySelector<HTMLElement>('.shelf-picker');
 if(picker)picker.hidden=false;
 panels.forEach((panel,i)=>panel.hidden=i!==0);
 buttons.forEach(button=>button.addEventListener('click',()=>{
  const id=button.dataset.projectChoice;
  panels.forEach(panel=>panel.hidden=panel.dataset.projectPanel!==id);
  buttons.forEach(item=>item.setAttribute('aria-pressed',String(item===button)));
  const status=shelf.querySelector<HTMLElement>('[data-shelf-status]');
  if(status)status.textContent=`Showing ${button.querySelector('strong')?.textContent}`;
 }));
}
</script>
<style>
.shelf-panel[hidden],.shelf-picker[hidden]{display:none!important}
.project-shelf .shelf-panel{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.25fr);gap:var(--space-7);align-items:center;margin:0;background:transparent;border:0;border-radius:0;overflow:visible;padding:0 0 var(--space-5)}
.shelf-visual{min-width:0;display:grid;place-items:center;background:transparent;border-radius:0;padding:0}
.shelf-visual :global(.game-case){width:100%;max-width:calc(var(--space-10)*2.5)}
.shelf-visual :global(img.media){max-height:calc(var(--space-10)*2);object-fit:contain}
.shelf-symbol{display:grid;place-items:center;width:100%;min-height:calc(var(--space-10)*2);color:var(--text-secondary)}
.shelf-symbol :global(svg){width:var(--space-9);height:var(--space-9);fill:currentColor}
.shelf-copy{min-width:0;max-width:48ch}
.project-shelf .shelf-copy h3{font-size:var(--text-display-md);line-height:var(--lh-display);margin:var(--space-3) 0;overflow-wrap:anywhere}
.shelf-copy p{margin-block:var(--space-3)}
.shelf-copy .button{margin-top:var(--space-2)}
.shelf-picker{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,15rem),1fr));gap:var(--space-2);margin-top:var(--space-3)}
.shelf-picker button{display:flex;align-items:center;text-align:left;gap:var(--space-3);padding:var(--space-3);color:var(--text-heading);background:var(--surface-card);border:var(--border-hairline) solid var(--border-default);border-radius:var(--radius-md);cursor:pointer;min-width:0;transition:transform var(--dur-med) var(--ease-standard),background-color var(--dur-med) var(--ease-standard),border-color var(--dur-med) var(--ease-standard),box-shadow var(--dur-med) var(--ease-standard)}
.shelf-picker button[aria-pressed=true]{background:var(--surface-card);border-color:var(--accent-heritage-strong);--selection-shadow:inset 0 calc(-1 * var(--border-thick)) 0 var(--accent-heritage-strong);box-shadow:var(--selection-shadow),var(--hover-shadow,0 0 0 transparent)}
.shelf-thumb{width:var(--space-7);height:var(--space-7);flex-shrink:0;display:grid;place-items:center;overflow:hidden;border-radius:14px;color:var(--text-heading);background:linear-gradient(145deg,color-mix(in srgb,var(--accent-heritage-strong) 30%,transparent),color-mix(in srgb,var(--accent-2,#5eead4) 16%,transparent));border:var(--border-hairline) solid var(--border-default);box-shadow:inset 0 1px 0 rgba(255,255,255,.18),0 6px 16px -8px rgba(0,0,0,.5)}
.shelf-thumb:has(svg){background:none;border:0;box-shadow:none;border-radius:0;color:var(--accent-heritage-strong)}
.shelf-thumb :global(svg){width:var(--space-6);height:var(--space-6);transition:filter var(--dur-med) var(--ease-standard),color var(--dur-med) var(--ease-standard)}
.shelf-thumb:has(img){border-radius:12px}
@media(hover:hover) and (pointer:fine){.shelf-picker button:hover .shelf-thumb :global(svg){color:var(--hover-light);filter:drop-shadow(0 0 8px var(--spot-text))}}
.shelf-picker button[aria-pressed=true] .shelf-thumb :global(svg){color:var(--hover-light);filter:drop-shadow(0 0 6px var(--spot-text))}
.shelf-item-copy{grid-template-rows:2.6em auto;align-content:center}
.shelf-item-copy strong{align-self:end}
.shelf-thumb img{width:100%;height:100%;object-fit:cover}
.shelf-item-copy>span::before{content:"";display:inline-block;width:7px;height:7px;margin-right:var(--space-2);border-radius:50%;background:#5eead4;box-shadow:0 0 8px #5eead4;vertical-align:1px;animation:shelf-live 2.4s ease-in-out infinite}
@keyframes shelf-live{50%{opacity:.45}}
@media(prefers-reduced-motion:reduce){.shelf-item-copy>span::before{animation:none}}
.shelf-thumb img{width:100%;height:100%;object-fit:cover}
.shelf-thumb :global(svg){width:var(--space-5);height:var(--space-5);fill:currentColor}
@media(hover:hover) and (pointer:fine){.shelf-picker button:hover{border-color:var(--hover-light);background-image:radial-gradient(240px circle at var(--mx,50%) var(--my,50%),var(--spot),transparent 65%)}}
.project-shelf .shelf-copy{max-width:68ch;justify-self:start}
.project-shelf .shelf-copy>p:not(.label):not(.shelf-team){max-width:56ch}
.shelf-titlerow{display:flex;flex-wrap:wrap;align-items:center;gap:var(--space-2) var(--space-3);margin:var(--space-3) 0}
.shelf-titlerow h3{margin:0!important}
.shelf-meta{list-style:none;display:flex;flex-wrap:wrap;gap:var(--space-1) var(--space-2);margin:0;padding:0}
.shelf-meta a{display:inline-block;padding:2px var(--space-2);border-radius:999px;border:var(--border-hairline) solid var(--border-default);background:transparent;font-size:.6875rem;line-height:1.5;color:var(--text-secondary);text-decoration:none}
.shelf-team{display:flex;flex-wrap:wrap;gap:var(--space-2) var(--space-3);margin:0 0 var(--space-4);font-size:var(--text-body-sm);color:var(--text-secondary)}
.shelf-team span{font-size:var(--text-person-tag);text-transform:uppercase;letter-spacing:.12em;font-weight:500;color:var(--text-secondary)}
.shelf-item-copy{min-width:0;display:grid;gap:var(--space-1)}
.shelf-item-copy strong{font-size:var(--text-body-sm);line-height:1.3;overflow-wrap:anywhere}
.shelf-item-copy>span{font-size:var(--text-body-sm);color:var(--text-secondary)}
.shelf-indicator{margin-inline-start:auto}
.shelf-picker button[aria-pressed=true] .shelf-indicator{transform:rotate(45deg)}
@media(max-width:64rem){.shelf-picker{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media(max-width:40rem){.project-shelf .shelf-panel{grid-template-columns:minmax(0,1fr);padding:var(--space-4);gap:var(--space-3)}.shelf-visual{padding:var(--space-1)}.shelf-visual :global(.game-case){max-width:calc(var(--space-9)*2)}.shelf-visual :global(img.media){max-height:calc(var(--space-9)*2)}.shelf-symbol{min-height:var(--space-10)}.project-shelf .shelf-copy h3{font-size:var(--text-display-sm)}.shelf-picker button{padding:var(--space-2);gap:var(--space-2)}.shelf-thumb{width:var(--space-6);height:var(--space-7)}.shelf-item-copy>span,.shelf-indicator{display:none}}
/* Match the portfolio’s responsive controls without moving reading text. */
.shelf-panel:not([hidden]) .shelf-visual{animation:scrim-arrive var(--dur-med) var(--ease-standard) both}
.shelf-thumb,.shelf-indicator{transition:transform var(--dur-med) var(--ease-responsive)}
.shelf-picker button[aria-pressed=true] .shelf-thumb{animation:shelf-select var(--dur-decorative) var(--ease-responsive) both}
@keyframes shelf-select{0%{transform:scale(.9)}60%{transform:scale(1.06)}100%{transform:scale(1)}}
</style>
