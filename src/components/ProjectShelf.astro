---
import GameCase from './GameCase.astro';
import Media from './Media.astro';
import globe from '../assets/icons/bootstrap/globe.svg?raw';
import people from '../assets/icons/bootstrap/people.svg?raw';
import layers from '../assets/icons/bootstrap/layers.svg?raw';
const {projects}=Astro.props;
const icons:Record<string,string>={'xr-us-museums':globe,'game-accessibility':people};
---
<div class="project-shelf" data-project-shelf>
  <div class="shelf-panels">
    {projects.map((p:any)=><article class="shelf-panel feature-project" id={`shelf-${p.id}`} aria-labelledby={`shelf-title-${p.id}`} data-project-panel={p.id}>
      <div class="shelf-visual">
        {p.id==='vrchaeology'&&p.data.heroMedia&&p.data.gallery?.length?<GameCase cover={p.data.heroMedia} images={p.data.gallery} name={p.data.name} description={p.data.shortDescription} credits={p.data.credits||[]} creditsHref={`/projects/${p.id}/#credits-heading`} galleryHref={`/projects/${p.id}/#gallery-heading`}/>:p.data.heroMedia?<Media media={p.data.heroMedia} natural/>:<div class="shelf-symbol" aria-hidden="true" set:html={icons[p.id]||layers}/>}
      </div>
      <div class="shelf-copy"><p class="label">{p.id==='vrchaeology'?'Flagship project · ':''}{p.data.status==='active'?'Active project':'Completed project'}</p><h3 id={`shelf-title-${p.id}`}>{p.data.name}</h3>{p.data.shortDescription&&<p>{p.data.shortDescription}</p>}<a class="button" href={`/projects/${p.id}/`}>View project <span aria-hidden="true">↗</span></a></div>
    </article>)}
  </div>
  <div class="shelf-picker" role="group" aria-label="Choose a project" hidden>
    {projects.map((p:any,i:number)=><button type="button" data-project-choice={p.id} aria-controls={`shelf-${p.id}`} aria-pressed={i===0?'true':'false'}><span class="shelf-thumb" aria-hidden="true">{p.data.heroMedia?<img src={p.data.heroMedia.src} alt="" width="64" height="64"/>:<span set:html={icons[p.id]||layers}/>}</span><span class="shelf-item-copy"><strong>{p.data.name}</strong><span>{p.data.status==='active'?'Active project':'Completed project'}</span></span><span class="shelf-indicator" aria-hidden="true">↗</span></button>)}
  </div>
  <p class="visually-hidden" data-shelf-status role="status"></p>
</div>
<script>
for(const shelf of document.querySelectorAll<HTMLElement>('[data-project-shelf]')){
 const panels=Array.from(shelf.querySelectorAll<HTMLElement>('[data-project-panel]'));
 const buttons=Array.from(shelf.querySelectorAll<HTMLButtonElement>('[data-project-choice]'));
 const picker=shelf.querySelector<HTMLElement>('.shelf-picker');
 if(picker)picker.hidden=false;
 panels.forEach((panel,i)=>panel.hidden=i!==0);
 buttons.forEach(button=>button.addEventListener('click',()=>{
  const id=button.dataset.projectChoice;
  panels.forEach(panel=>panel.hidden=panel.dataset.projectPanel!==id);
  buttons.forEach(item=>item.setAttribute('aria-pressed',String(item===button)));
  const status=shelf.querySelector<HTMLElement>('[data-shelf-status]');
  if(status)status.textContent=`Showing ${button.querySelector('strong')?.textContent}`;
 }));
}
</script>
<style>
.shelf-panel[hidden],.shelf-picker[hidden]{display:none!important}
.project-shelf .shelf-panel{display:grid;grid-template-columns:minmax(0,2fr) minmax(0,3fr);gap:var(--space-5);align-items:center;margin:0;background:transparent;border:0;border-radius:0;overflow:hidden;padding:0}
.shelf-visual{min-width:0;display:grid;place-items:center;background:var(--surface-card);border-radius:var(--radius-sm);padding:var(--space-2)}
.shelf-visual :global(.game-case){width:100%;max-width:calc(var(--space-10)*2.5)}
.shelf-visual :global(img.media){max-height:calc(var(--space-10)*2);object-fit:contain}
.shelf-symbol{display:grid;place-items:center;width:100%;min-height:calc(var(--space-10)*2);color:var(--text-secondary)}
.shelf-symbol :global(svg){width:var(--space-9);height:var(--space-9);fill:currentColor}
.shelf-copy{min-width:0;max-width:48ch}
.project-shelf .shelf-copy h3{font-size:var(--text-display-md);line-height:var(--lh-display);margin:var(--space-3) 0;overflow-wrap:anywhere}
.shelf-copy p{margin-block:var(--space-3)}
.shelf-copy .button{margin-top:var(--space-2)}
.shelf-picker{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:var(--space-2);margin-top:var(--space-3)}
.shelf-picker button{display:flex;align-items:center;text-align:left;gap:var(--space-3);padding:var(--space-3);color:var(--text-heading);background:transparent;border:0;border-top:var(--border-hairline) solid var(--border-default);border-radius:0;cursor:pointer;min-width:0;transition:background var(--dur-med) var(--ease-standard),border-color var(--dur-med) var(--ease-standard),box-shadow var(--dur-med) var(--ease-standard)}
.shelf-picker button[aria-pressed=true]{background:transparent;border-color:var(--accent-heritage-strong);--selection-shadow:inset 0 calc(-1 * var(--border-thick)) 0 var(--accent-heritage-strong);box-shadow:var(--selection-shadow),var(--hover-shadow,0 0 0 transparent)}
.shelf-thumb{width:var(--space-7);height:var(--space-7);flex-shrink:0;display:grid;place-items:center;overflow:hidden;border-radius:var(--radius-xs)}
.shelf-thumb img{width:100%;height:100%;object-fit:cover}
.shelf-thumb :global(svg){width:var(--space-5);height:var(--space-5);fill:currentColor}
.shelf-item-copy{min-width:0;display:grid;gap:var(--space-1)}
.shelf-item-copy strong{font-size:var(--text-body-sm);line-height:1.3;overflow-wrap:anywhere}
.shelf-item-copy>span{font-size:var(--text-body-sm);color:var(--text-secondary)}
.shelf-indicator{margin-inline-start:auto}
.shelf-picker button[aria-pressed=true] .shelf-indicator{transform:rotate(45deg)}
@media(max-width:64rem){.shelf-picker{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media(max-width:40rem){.project-shelf .shelf-panel{grid-template-columns:minmax(0,1fr);padding:var(--space-4);gap:var(--space-3)}.shelf-visual{padding:var(--space-1)}.shelf-visual :global(.game-case){max-width:calc(var(--space-9)*2)}.shelf-visual :global(img.media){max-height:calc(var(--space-9)*2)}.shelf-symbol{min-height:var(--space-10)}.project-shelf .shelf-copy h3{font-size:var(--text-display-sm)}.shelf-picker button{padding:var(--space-2);gap:var(--space-2)}.shelf-thumb{width:var(--space-6);height:var(--space-7)}.shelf-item-copy>span,.shelf-indicator{display:none}}
/* Match the portfolio’s responsive controls without moving reading text. */
.shelf-panel:not([hidden]) .shelf-visual{animation:scrim-arrive var(--dur-med) var(--ease-standard) both}
.shelf-thumb,.shelf-indicator{transition:transform var(--dur-med) var(--ease-responsive)}
.shelf-picker button[aria-pressed=true] .shelf-thumb{animation:shelf-select var(--dur-decorative) var(--ease-responsive) both}
@keyframes shelf-select{0%{transform:scale(.9)}60%{transform:scale(1.06)}100%{transform:scale(1)}}
</style>
