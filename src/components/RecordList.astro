---
import { entryUrl, dateLabel, roles, labels } from '../lib/format.mjs';
interface Props { title: string; records: any[]; peopleLinks?: boolean; more?: string; cards?: boolean; id?: string; }
const {title,records,peopleLinks=false,more,cards=false,id}=Astro.props;
---
<section id={id} class="record-section">
  <div class="section-heading"><h2>{title}</h2>{more && <a class="text-link" href={more}>View all {title.toLowerCase()}</a>}</div>
  {records.length ? <ul class:list={['records',{'card-grid':cards}]}>
    {records.map(record => {
      const href=entryUrl(peopleLinks ? {...record,collection:'people'} : record);
      const d=record.data;
      return <li class:list={{card:cards}}>
        {(d.type||d.status||d.role) && <p class="label record-kind">{d.role ? roles[d.role as keyof typeof roles] : record.collection==='presentations'&&d.type==='conference'?'Conference talk':labels[(d.type||d.status) as keyof typeof labels] || d.type}</p>}
        <h3>{href ? <a href={href}>{d.name ?? d.title}</a> : d.name ?? d.title}</h3>
        {d.draft && <p class="label">Draft · Not published</p>}
        {d.authors && <p class="authors">{d.authors}</p>}
        {(d.venue || d.year || d.date || d.awardingBody) && <p class="label metadata">{[d.venue || d.awardingBody,d.location,d.year || dateLabel(d.date)].filter(Boolean).join(' · ')}</p>}
        {(d.shortDescription || d.summary || d.description) && <p>{d.shortDescription || d.summary || d.description}</p>}
        <div class="links">
          {d.award && <span class="badge">{d.award}</span>}
          {d.pdf && <a href={d.pdf}>PDF</a>}{d.doi && <a href={d.doi}>DOI</a>}{d.code && <a href={d.code}>Code</a>}
          {d.slides && <a href={d.slides}>Slides</a>}{d.video && <a href={d.video}>Video</a>}
          {d.link && <a href={d.link}>Award details</a>}
          {d.externalLink && <a href={d.externalLink}>Read the source</a>}
        </div>
      </li>;
    })}
  </ul> : <p class="empty-note">No entries published yet.</p>}
</section>
