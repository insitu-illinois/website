---
import layers from '../assets/icons/bootstrap/layers.svg?raw';
import people from '../assets/icons/bootstrap/people.svg?raw';
import newspaper from '../assets/icons/bootstrap/newspaper.svg?raw';
import paper from '../assets/icons/bootstrap/file-earmark-pdf.svg?raw';
import easel from '../assets/icons/bootstrap/easel.svg?raw';
import globe from '../assets/icons/bootstrap/globe.svg?raw';
import award from '../assets/icons/bootstrap/award.svg?raw';
import link from '../assets/icons/bootstrap/link-45deg.svg?raw';
const icons:Record<string,string>={layers,people,newspaper,paper,easel,globe,award,link};
const {name='layers'}=Astro.props;
const paths=(icons[name]||layers).trim().replace(/^<svg[^>]*>/,'').replace(/<\/svg>$/,'');
---
<svg class="content-icon" viewBox="0 0 16 16" aria-hidden="true" focusable="false" set:html={paths}/>
