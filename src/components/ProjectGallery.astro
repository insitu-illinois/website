---
const { images=[],id='gallery',title='Inside the experience',description='',source='' }=Astro.props;
---
{images.length>0&&<section class:list={['project-gallery',{'archive-gallery':id!=='gallery'}]} aria-labelledby={`${id}-heading`}>
  <h2 id={`${id}-heading`}>{title}</h2>
  {description&&<p>{description} {source&&<a href={source}>Original gallery</a>}</p>}
  {id!=='gallery'&&<p class="archive-scroll-hint">Scroll horizontally to see more images</p>}
  <div class="gallery-grid" tabindex={id!=='gallery'?0:undefined} role={id!=='gallery'?'region':undefined} aria-label={id!=='gallery'?`${title} images`:undefined}>{images.map((media:any,index:number)=><figure>
    <img id={`${id}-image-${index}`} src={media.src} alt={media.alt} loading="lazy" decoding="async" width="1600" height="1000"/>
    <figcaption>{media.caption&&<p>{media.caption}</p>}
      {media.animatedSrc ? <><button type="button" class="button secondary" hidden data-archive-animation={media.animatedSrc} data-poster={media.src} aria-controls={`${id}-image-${index}`} aria-pressed="false">Play animation<span class="visually-hidden">: {media.caption||media.alt}</span></button><noscript><a href={media.animatedSrc}>Open animation</a></noscript></> : <a href={media.src} aria-label={`View full image: ${media.caption||media.alt}`}>View full image</a>}
    </figcaption>
  </figure>)}</div>
</section>}


<style>
  @media(min-width:64rem) { .archive-gallery .gallery-grid { grid-template-columns:repeat(4,minmax(0,1fr)); gap:var(--space-4); } }
  .archive-gallery .gallery-grid { position:relative; min-width:0; max-width:100%; }
  .archive-gallery figcaption { padding-block:var(--space-2); }
  .archive-gallery button { min-height:var(--space-7); }
  .archive-scroll-hint { color:var(--text-secondary); font-size:var(--text-body-sm); }
  @media(max-width:63.999rem) {
    .archive-gallery .gallery-grid { display:grid; grid-auto-flow:column; grid-auto-columns:min(80%,calc(var(--space-10) * 2.5)); grid-template-columns:none; overflow-x:auto; gap:var(--space-4); padding:var(--space-1) var(--space-1) var(--space-3); scroll-snap-type:x proximity; }
    .archive-gallery figure { scroll-snap-align:start; }
    :global(html[data-text-size="200"]) .archive-gallery .gallery-grid { grid-auto-columns:100%; }
  }
  @media(min-width:64rem) { .archive-scroll-hint { display:none; } }
</style>
