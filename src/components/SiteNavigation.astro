---
const path = Astro.url.pathname;
const research = [['Projects','/projects/'],['Research themes','/about/#themes'],['Presentations','/presentations/'],['Awards & funding','/awards-funding/']];
const current = (href:string) => !href.includes('#') && path.startsWith(href);
const inResearch = ['/projects/','/themes/','/presentations/','/awards-funding/'].some(prefix=>path.startsWith(prefix));
---
<nav class="primary-navigation" aria-label="Main navigation">
  <button type="button" class="mobile-menu-toggle" aria-label="Menu" aria-expanded="false" aria-controls="primary-links" hidden><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16" /></svg></button>
  <ul class="nav-list" id="primary-links">
    <li><a href="/about/" aria-current={current('/about/')?'page':undefined}>About</a></li>
    <li>
      <details class="research-menu">
        <summary class:list={{'section-current':inResearch}}>Research <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>{inResearch&&<span class="visually-hidden"> (current section)</span>}</summary>
        <ul class="research-links">{research.map(([label,href])=><li><a href={href} aria-current={current(href)?'page':undefined}>{label}</a></li>)}</ul>
      </details>
    </li>
    <li><a href="/people/" aria-current={current('/people/')?'page':undefined}>People</a></li>
    <li><a href="/publications/" aria-current={current('/publications/')?'page':undefined}>Publications</a></li>
    <li><a href="/news/" aria-current={current('/news/')?'page':undefined}>News</a></li>
    <li class="nav-join"><a href="/join/" aria-current={current('/join/')?'page':undefined}>Join</a></li>
  </ul>
</nav>
<script>
  const nav = document.querySelector<HTMLElement>('.primary-navigation')!;
  const toggle = nav.querySelector<HTMLButtonElement>('.mobile-menu-toggle')!;
  const list = nav.querySelector<HTMLElement>('.nav-list')!;
  const research = nav.querySelector<HTMLDetailsElement>('.research-menu')!;
  const summary = research.querySelector('summary')!;
  const narrow = matchMedia('(max-width: 51.999rem)');
  const closeResearch = () => { research.open = false; };
  const closeMobile = () => { toggle.setAttribute('aria-expanded','false'); list.hidden = narrow.matches; closeResearch(); };
  const resize = () => {
    const hadFocus = list.contains(document.activeElement);
    toggle.hidden = !narrow.matches;
    closeMobile();
    if (narrow.matches && hadFocus) toggle.focus();
  };
  resize();
  narrow.addEventListener('change',resize);
  toggle.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') !== 'true';
    toggle.setAttribute('aria-expanded',String(open)); list.hidden = !open;
    if (!open) closeResearch();
  });
  nav.addEventListener('keydown',event=>{
    if (event.key !== 'Escape') return;
    if (research.open) { event.preventDefault(); closeResearch(); summary.focus(); }
    else if (narrow.matches && toggle.getAttribute('aria-expanded') === 'true') { event.preventDefault(); closeMobile(); toggle.focus(); }
  });
  nav.addEventListener('focusout',event=>{
    if (!nav.contains(event.relatedTarget as Node|null)) closeMobile();
    else if (!research.contains(event.relatedTarget as Node|null)) closeResearch();
  });
  document.addEventListener('click',event=>{
    if (!nav.contains(event.target as Node)) closeMobile();
    else if (!research.contains(event.target as Node)) closeResearch();
  });
  list.querySelectorAll('a').forEach(link=>link.addEventListener('click',()=>closeMobile()));
</script>
