---
import { destinations, primaryMenu, isCurrent, inSection } from '../config/navigation.mjs';
// Menu items come from src/config/navigation.mjs. Do not write links here.
const path = Astro.url.pathname;
const current = (href:string) => isCurrent(href,path) ? 'page' : undefined;
const link = (id:string) => destinations[id as keyof typeof destinations];
---
<nav class="primary-navigation" aria-label="Main navigation">
  <button type="button" class="mobile-menu-toggle" aria-label="Menu" aria-expanded="false" aria-controls="primary-links" hidden><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16" /></svg></button>
  <ul class="nav-list" id="primary-links">
    {primaryMenu.map(entry=>{
      if('group' in entry){
        const active=inSection(entry.sections!,path);
        return <li>
      <details class="research-menu">
        <summary class:list={{'section-current':active}}>{entry.group} <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>{active&&<span class="visually-hidden"> (current section)</span>}</summary>
        <ul class="research-links">{entry.items!.map(id=><li><a href={link(id).href} aria-current={current(link(id).href)}>{link(id).label}</a></li>)}</ul>
      </details>
    </li>;
      }
      return <li class={entry.emphasis?'nav-join':undefined}><a href={link(entry.id!).href} aria-current={current(link(entry.id!).href)}>{link(entry.id!).label}</a></li>;
    })}
  </ul>
</nav>
<script>
  import {setVisible,setDetailsOpen} from '../scripts/motion';
  const nav = document.querySelector<HTMLElement>('.primary-navigation')!;
  const toggle = nav.querySelector<HTMLButtonElement>('.mobile-menu-toggle')!;
  const list = nav.querySelector<HTMLElement>('.nav-list')!;
  const research = nav.querySelector<HTMLDetailsElement>('.research-menu')!;
  const summary = research.querySelector('summary')!;
  const narrow = matchMedia('(max-width: 51.999rem)');
  const closeResearch = () => { void setDetailsOpen(research,false); };
  const closeMobile = () => { toggle.setAttribute('aria-expanded','false'); void setVisible(list,!narrow.matches); closeResearch(); };
  const resize = () => {
    const hadFocus = list.contains(document.activeElement);
    toggle.hidden = !narrow.matches;
    closeMobile();
    if (narrow.matches && hadFocus) toggle.focus();
  };
  // Preserve a disclosure the visitor opened before this module finished loading.
  toggle.hidden = !narrow.matches;
  list.hidden = narrow.matches;
  narrow.addEventListener('change',resize);
  toggle.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') !== 'true';
    toggle.setAttribute('aria-expanded',String(open)); void setVisible(list,open);
    if (!open) closeResearch();
  });
  nav.addEventListener('keydown',event=>{
    if (event.key !== 'Escape') return;
    if ((research.dataset.expanded??String(research.open))==='true') { event.preventDefault(); closeResearch(); summary.focus(); }
    else if (narrow.matches && toggle.getAttribute('aria-expanded') === 'true') { event.preventDefault(); closeMobile(); toggle.focus(); }
  });
  nav.addEventListener('focusout',event=>{
    if (!nav.contains(event.relatedTarget as Node|null)) closeMobile();
    else if (!research.contains(event.relatedTarget as Node|null)) closeResearch();
  });
  document.addEventListener('click',event=>{
    if (!nav.contains(event.target as Node)) closeMobile();
    else if (!research.contains(event.target as Node)) closeResearch();
  });
  list.querySelectorAll('a').forEach(link=>link.addEventListener('click',()=>closeMobile()));
</script>
