---
interface Props { name:string; image:{src:string;alt:string;caption?:string}; description:string; credits:{role:string;names:string}[]; index:number; mini?:boolean; }
const {name,image,credits,index,mini=false}=Astro.props;
---
<div class:list={['print-page',{mini}]}>
  <div class="print-heading"><span class="print-kicker">Field notes / {String(index+1).padStart(2,'0')}</span><h2 class="print-name">{name}</h2><span class="print-subtitle">A virtual field school</span></div>
  <img class="print-image" src={image.src} alt={mini?'':image.alt} width="1600" height="1000" loading="lazy"/>
  <div class="print-columns"><div><h3>{image.caption||'Inside the experience'}</h3><p>{image.alt}</p></div><div class="print-credits"><h3>Production notes</h3>{credits.map(credit=><p><span>{credit.role}</span><strong>{credit.names.replaceAll('\n',', ')}</strong></p>)}</div></div>
  <div class="print-footer"><span>Game Studies and Design<br/>The stu/dio</span><span>IN/SITU<br/>{String(index+1).padStart(2,'0')}</span></div>
</div>
<style>
.print-page { --text-heading:var(--white); --text-primary:var(--neutral-200); --text-secondary:var(--neutral-300); background:var(--neutral-950); color:var(--neutral-200); padding:var(--space-5); border:var(--border-hairline) solid var(--neutral-600); box-shadow:var(--shadow-inverse); }
.print-heading { display:flex; flex-direction:column; gap:var(--space-2); padding-bottom:var(--space-5); border-bottom:var(--border-hairline) solid var(--neutral-600); }
.print-kicker,.print-subtitle,.print-footer { font-family:var(--font-mono); font-size:var(--text-person-tag); color:var(--neutral-300); }
.print-name { margin:0; color:var(--white); font-family:var(--font-display); font-size:var(--text-display-sm); font-weight:var(--weight-display); }
.print-image { width:100%; height:auto; max-height:30dvh; margin-block:var(--space-5); aspect-ratio:8/5; object-fit:contain; }
.print-columns { display:grid; grid-template-columns:minmax(0,1.5fr) minmax(0,1fr); gap:var(--space-5); }
.print-columns>* { min-width:0; }
.print-columns h3 { color:var(--white); font-size:var(--text-body-lg); margin:0 0 var(--space-3); }
.print-columns p { font-size:var(--text-body-sm); margin:0 0 var(--space-3); }
.print-credits { border-left:var(--border-hairline) solid var(--neutral-600); padding-left:var(--space-5); }
.print-credits span,.print-credits strong { display:block; }
.print-credits span { color:var(--neutral-300); }
.print-credits strong { color:var(--white); font-weight:400; }
.print-footer { display:flex; justify-content:space-between; gap:var(--space-4); margin-top:var(--space-5); border-top:var(--border-hairline) solid var(--neutral-600); padding-top:var(--space-4); }
.print-footer span:last-child { text-align:right; }
/* The small copy is decorative, while the same complete paper in the dialog uses resizable text. */
.mini { width:100%; height:100%; padding:6cqi; overflow:hidden; text-align:left; }
.mini .print-heading { gap:1cqi; padding-bottom:3cqi; }
.mini .print-name { font-size:9cqi; line-height:1.2; }
.mini .print-kicker,.mini .print-subtitle,.mini .print-footer { font-size:2.4cqi; line-height:1.4; }
.mini .print-image { margin-block:4cqi; max-height:none; }
.mini .print-columns { gap:4cqi; }
.mini .print-columns h3 { font-size:3cqi; line-height:1.3; margin-bottom:2cqi; }
.mini .print-columns p { font-size:2.5cqi; line-height:1.45; margin-bottom:2cqi; }
.mini .print-credits { padding-left:3cqi; }
.mini .print-description { display:none; }
.mini .print-footer { margin-top:3cqi; padding-top:3cqi; }
@media(max-width:30rem) { .print-page:not(.mini) { padding:var(--space-4); } .print-page:not(.mini) .print-columns { grid-template-columns:minmax(0,1fr); } .print-page:not(.mini) .print-credits { border-left:0; border-top:var(--border-hairline) solid var(--neutral-600); padding:var(--space-4) 0 0; } }
</style>
