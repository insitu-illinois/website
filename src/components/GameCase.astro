---
interface Image { src:string; alt:string; caption?:string; }
interface Props { cover:Image; images:Image[]; name:string; }
const {cover,images,name}=Astro.props;
---
<div class="game-case" data-game-case>
  <button class="case-toggle" data-case-toggle hidden type="button" aria-expanded="false" aria-controls="case-booklet" aria-label={`Open the case: ${name} artwork`} aria-describedby="case-description" data-name={name}>
    <span class="case-stage" aria-hidden="true">
      <span class="case-object">
        <span class="case-tray"><span class="case-disc"><img src={images[0].src} alt=""/></span></span>
        <span class="case-lid">
          <span class="case-front"><img class="case-cover-art" src={cover.src} alt="" loading="eager" width="1200" height="1800"/></span>
          <span class="case-back"><span class="case-paper"><span class="paper-images">{images.slice(0,4).map(image=><img src={image.src} alt="" loading="lazy"/>)}</span></span></span>
        </span>
      </span>
    </span>
    <span class="case-action" data-case-action>Open the case <span aria-hidden="true">↗</span></span>
  </button>
  <span id="case-description" class="visually-hidden">{cover.alt} Interactive artwork presentation; opens a disc case and a booklet of game images.</span>
  <noscript><img class="media media-natural" src={cover.src} alt={cover.alt} width="1200" height="1800"/><p><a href="#gallery-heading">Explore the game images</a></p></noscript>
  <div class="case-booklet" id="case-booklet" hidden>
    <div class="booklet-toolbar"><p class="label" role="status" data-scene-status>Scene 1 of {images.length}</p><div class="booklet-buttons"><button type="button" class="button secondary" data-scene-prev aria-label="Previous game image">←</button><button type="button" class="button secondary" data-scene-next aria-label="Next game image">→</button></div></div>
    {images.map((image,index)=><figure data-scene hidden={index!==0}><img src={image.src} alt={image.alt} width="1600" height="1000" loading="lazy"/><figcaption>{image.caption}</figcaption></figure>)}
    <a class="text-link" href="#gallery-heading">View the full gallery</a>
  </div>
</div>
<script>
  document.querySelectorAll<HTMLElement>('[data-game-case]').forEach(root=>{
    const toggle=root.querySelector<HTMLButtonElement>('[data-case-toggle]')!;
    const action=root.querySelector<HTMLElement>('[data-case-action]')!;
    const booklet=root.querySelector<HTMLElement>('.case-booklet')!;
    const scenes=[...root.querySelectorAll<HTMLElement>('[data-scene]')];
    const status=root.querySelector<HTMLElement>('[data-scene-status]')!;
    let current=0;
    function setOpen(open:boolean) {
      root.dataset.open=String(open);
      toggle.setAttribute('aria-expanded',String(open));
      toggle.setAttribute('aria-label',`${open?'Close':'Open'} the case: ${toggle.dataset.name} artwork`);
      action.textContent=open?'Close the case':'Open the case ↗';
      booklet.hidden=!open;
    }
    toggle.hidden=false;
    toggle.addEventListener('click',()=>setOpen(toggle.getAttribute('aria-expanded')!=='true'));
    root.addEventListener('keydown',event=>{
      if(event.key==='Escape'&&toggle.getAttribute('aria-expanded')==='true') {
        event.preventDefault();setOpen(false);toggle.focus();
      }
    });
    function showScene(step:number) {
      current=(current+step+scenes.length)%scenes.length;
      scenes.forEach((scene,index)=>{scene.hidden=index!==current;});
      status.textContent=`Scene ${current+1} of ${scenes.length}`;
    }
    root.querySelector('[data-scene-prev]')!.addEventListener('click',()=>showScene(-1));
    root.querySelector('[data-scene-next]')!.addEventListener('click',()=>showScene(1));
  });
</script>
<style>
  .game-case { min-width:0; }
  .case-toggle { display:block; width:100%; border:0; padding:0; background:transparent; color:var(--text-heading); font:inherit; border-radius:var(--radius-md); }
  .case-stage { display:block; position:relative; width:100%; aspect-ratio:5/4; perspective:calc(var(--space-10) * 10); background:radial-gradient(ellipse at 50% 75%,var(--border-default),transparent 62%); }
  .case-object { display:block; position:absolute; top:10%; left:49%; width:43%; aspect-ratio:2/3; transform:translateX(-50%) rotateY(-16deg) rotateX(5deg); transform-style:preserve-3d; transition:transform var(--dur-decorative) var(--ease-standard); }
  .case-tray,.case-lid,.case-front,.case-back { position:absolute; inset:0; display:block; border-radius:var(--radius-xs); }
  .case-tray { display:grid; place-items:center; background:var(--neutral-900); border:var(--space-1) solid var(--neutral-800); box-shadow:var(--shadow-inverse); transform:translateZ(calc(-1 * var(--space-2))); }
  .case-tray::before { content:""; position:absolute; inset:var(--space-2); border:var(--border-hairline) solid var(--neutral-600); border-radius:var(--radius-xs); }
  .case-lid { transform-origin:left center; transform-style:preserve-3d; transition:transform var(--dur-decorative) var(--ease-standard); box-shadow:var(--shadow-raised); }
  .case-front,.case-back { backface-visibility:hidden; overflow:hidden; border:var(--border-thick) solid var(--neutral-800); }
  .case-front { background:var(--neutral-950); }
  .case-cover-art { width:100%; height:100%; object-fit:contain; aspect-ratio:auto; }
  .case-front::after { content:""; position:absolute; inset:0; background:linear-gradient(100deg,transparent 2%,color-mix(in srgb,var(--white) 25%,transparent) 4%,transparent 8%,transparent 75%,color-mix(in srgb,var(--white) 10%,transparent)); box-shadow:inset var(--space-1) 0 var(--space-2) var(--neutral-950); }
  .case-back { transform:rotateY(180deg); background:var(--neutral-900); padding:var(--space-2); }
  .case-paper { display:flex; height:100%; flex-direction:column; justify-content:space-between; background:var(--white); color:var(--neutral-950); padding:var(--space-2); transform:rotate(-2deg); box-shadow:var(--shadow-card); }
  .paper-images { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:var(--space-1); margin-block:auto; }
  .paper-images img { width:100%; aspect-ratio:1; object-fit:cover; }
  .case-disc { position:relative; display:block; width:88%; aspect-ratio:1; border-radius:50%; padding:var(--space-1); background:conic-gradient(var(--white),var(--neutral-600),var(--neutral-200),var(--white),var(--neutral-500),var(--white)); box-shadow:var(--shadow-inverse); }
  .case-disc img { width:100%; height:100%; object-fit:cover; border-radius:50%; }
  .case-disc::after { content:""; position:absolute; width:18%; aspect-ratio:1; inset:41%; border-radius:50%; background:var(--neutral-900); border:var(--border-thick) solid var(--neutral-300); }
  .case-action { display:inline-flex; align-items:center; min-height:var(--space-7); font-family:var(--font-mono); font-size:var(--text-label-md); text-decoration:underline; text-underline-offset:var(--space-1); gap:var(--space-2); }
  [data-open="true"] .case-object { transform:translateX(0) rotateY(-5deg); }
  [data-open="true"] .case-lid { transform:rotateY(-155deg); }
  .case-booklet { margin-top:var(--space-5); padding:var(--space-4); background:var(--surface-page); border:var(--border-hairline) solid var(--border-default); border-radius:var(--radius-sm); box-shadow:var(--shadow-card); }
  .booklet-toolbar { display:flex; flex-wrap:wrap; gap:var(--space-3); align-items:center; justify-content:space-between; margin-bottom:var(--space-4); }
  .booklet-toolbar p { margin:0; }
  .booklet-buttons { display:flex; gap:var(--space-2); }
  .booklet-buttons button { min-width:var(--space-7); padding:var(--space-2); }
  .case-booklet figure { margin:0; }
  .case-booklet figure img { width:100%; height:auto; aspect-ratio:8/5; object-fit:contain; background:var(--surface-card); }
  .case-booklet figcaption { margin-top:var(--space-3); font-size:var(--text-body-sm); }
  @media (hover:hover) and (prefers-reduced-motion:no-preference) { :global(html:not([data-reduce-motion="true"])) .game-case:not([data-open="true"]) .case-toggle:hover .case-object { transform:translateX(-50%) rotateY(-8deg) rotateX(2deg) translateY(calc(-1 * var(--space-1))); } }
  @media (prefers-reduced-motion:reduce) { .case-object,.case-lid { transition:none; } }
  :global(html[data-reduce-motion="true"]) .case-object,:global(html[data-reduce-motion="true"]) .case-lid { transition:none; }
</style>
