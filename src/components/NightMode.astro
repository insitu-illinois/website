---
import UtilityIcon from './UtilityIcon.astro';
---
<span class="utility-control">
  <button type="button" class="accessibility-entry icon-control" data-night-mode aria-label="Night mode" aria-pressed="false" hidden>
    <span class="night-moon" aria-hidden="true">
      <UtilityIcon name="moon" class="moon-outline" />
      <UtilityIcon name="moonFilled" class="moon-fill" />
    </span>
  </button>
  <span class="utility-tooltip" data-theme-state aria-hidden="true">Turn on night mode</span>
</span>
<span class="theme-status" role="status" data-theme-status></span>
<script>
  import { savePreferences } from '../scripts/preferences';
  const button = document.querySelector<HTMLButtonElement>('[data-night-mode]');
  const status = document.querySelector<HTMLElement>('[data-theme-status]');
  if (button) {
    const sync = () => {
      const night = document.documentElement.dataset.theme === 'night';
      button.setAttribute('aria-pressed', String(night));
      document.querySelector('[data-theme-state]')!.textContent = night ? 'Turn off night mode' : 'Turn on night mode';
    };
    sync();
    button.hidden = false;
    document.addEventListener('insitu:preferences', sync);
    button.addEventListener('click', () => {
      const night = document.documentElement.dataset.theme !== 'night';
      document.documentElement.dataset.theme = night ? 'night' : 'light';
      const saved = savePreferences();
      if (status) status.textContent = `Night mode ${night ? 'on' : 'off'}.${saved ? '' : ' Browser storage is unavailable; this choice applies to the current page only.'}`;
    });
  }
</script>
