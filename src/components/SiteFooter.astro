---
// The one footer for every public page. Link columns come from src/config/navigation.mjs.
import footer from '../content/pages/footer.json';
import values from '../content/pages/values.json';
import AccessibilityEntry from './AccessibilityEntry.astro';
import LabContact from './LabContact.astro';
import signInIcon from '../assets/icons/bootstrap/box-arrow-in-right.svg?raw';
import { destinations, footerMenu } from '../config/navigation.mjs';
const signInPaths=signInIcon.trim().replace(/^<svg[^>]*>/,'').replace(/<\/svg>$/,'');
const copyrightYear=new Date().getUTCFullYear();
---
<footer class="site-footer">
  <div class="shell footer-grid">
    <div class="footer-identity">
      <div class="footer-brand-row"><a class="wordmark" href="/" aria-label="IN/SITU home">IN<span>/</span>SITU</a></div>
      {(!footer.draft||import.meta.env.DEV)&&<p class="label">{footer.institution}</p>}
      <ul class="footer-social" aria-label="Contact and social media">
        <li><svg viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.2" cy="6.8" r=".9" fill="currentColor"/></svg></li>
        <li class="footer-social-mail"><LabContact icon /></li>
        <li><svg viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="4"/><path d="M8 11v6M8 7.5v.01M12 17v-6M12 13c0-3 5-3.5 5 0v4"/></svg></li>
        <li><svg viewBox="0 0 24 24"><path d="M9 19c-4 1-4-2-6-2m12 4v-3.5c0-1 .1-1.4-.5-2 2.8-.3 5.5-1.4 5.5-6a4.6 4.6 0 0 0-1.3-3.2 4.2 4.2 0 0 0-.1-3.2s-1.1-.3-3.500 1.300a12.300 12.300 0 0 0-6.200 0C6.500 2.800 5.400 3.100 5.400 3.100a4.200 4.200 0 0 0-.1 3.200A4.600 4.600 0 0 0 4 9.500c0 4.600 2.700 5.700 5.500 6-.6.600-.6 1.200-.5 2V21"/></svg></li>
        <li><svg viewBox="0 0 24 24"><rect x="2.5" y="5" width="19" height="14" rx="4"/><path d="M10 9l5 3-5 3z"/></svg></li>
        <li><svg viewBox="0 0 24 24"><path d="M4 4l16 16M20 4L4 20"/></svg></li>
        <li><svg viewBox="0 0 24 24"><path d="M2 9l10-5 10 5-10 5z"/><path d="M6 11v5c3 2.500 9 2.500 12 0v-5"/></svg></li>
      </ul>
    </div>
    {footerMenu.map(column=><div>
      <h2 class="footer-heading">{column.heading}</h2>
      <ul>
        {column.items.map(id=>{
          if(id==='accessibility-settings')return <li><AccessibilityEntry /></li>;
          if(id==='values'&&values.draft&&!import.meta.env.DEV)return null;
          const {href,label}=destinations[id as keyof typeof destinations];
          return id==='admin'
            ?<li><a class="footer-login" href={href}><svg viewBox="0 0 16 16" aria-hidden="true" focusable="false" set:html={signInPaths}/>{label}</a></li>
            :<li><a href={href}>{label}</a></li>;
        })}
      </ul>
    </div>)}
  </div>
  <div class="shell footer-bottom"><p>© {copyrightYear} IN/SITU</p>{(!footer.draft||import.meta.env.DEV)&&footer.developerName&&<p>Developed by <a class="credit-link" href="https://sepafshar.com/" target="_blank" rel="noopener">{footer.developerName}<span class="visually-hidden"> (opens in a new tab)</span></a></p>}</div>
</footer>
