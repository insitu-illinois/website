---
import moon from '../assets/icons/material/dark-mode.svg?raw';
import sun from '../assets/icons/material/light-mode.svg?raw';
import moonFilled from '../assets/icons/material/moon-filled.svg?raw';
import accessibility from '../assets/icons/material/accessibility-new.svg?raw';
interface Props { name:'moon'|'moonFilled'|'sun'|'accessibility'; class?:string; }
const {name,class:className}=Astro.props;
// Trusted, locally vendored Google Material SVGs. License is beside the source assets.
const paths={moon,moonFilled,sun,accessibility}[name].replace(/^<svg[^>]*>/,'').replace(/<\/svg>$/,'');
---
<svg class={className} viewBox="0 0 24 24" aria-hidden="true" focusable="false" set:html={paths} />
