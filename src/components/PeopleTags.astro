---
import {hasPersonPage} from '../lib/format.mjs';
interface Props { people: any[]; label?:string; }
const {people,label='People mentioned'}=Astro.props;
---
{people.length>0 && <div class="people-metadata"><span class="people-caption">{label}</span><ul class="people-tags" aria-label={label}>{people.map(person=><li><a href={hasPersonPage(person)?`/people/${person.id}/`:`/people/#person-${person.id}`}>{person.data.name}</a></li>)}</ul></div>}
