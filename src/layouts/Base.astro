---
import '@fontsource/space-grotesk/latin-400';
import '@fontsource/space-grotesk/latin-500';
import '@fontsource/space-grotesk/latin-600';
import '@fontsource/source-sans-3/latin-400';
import '@fontsource/source-sans-3/latin-700';
import '@fontsource/source-sans-3/latin-400-italic';
import '../../design-system/styles.css';
import '../styles/base.css';
import footer from '../content/pages/footer.json';
import values from '../content/pages/values.json';
import AccessibilityEntry from '../components/AccessibilityEntry.astro';
import AccessibilityPanel from '../components/AccessibilityPanel.astro';
import NightMode from '../components/NightMode.astro';
import SiteNavigation from '../components/SiteNavigation.astro';
import BackgroundIcons from '../components/BackgroundIcons.astro';
import LabContact from '../components/LabContact.astro';
import '../styles/navigation.css';
import preferencesBootstrap from '../scripts/preferences-init.js?raw';
import '../styles/motion.css';
import '../styles/compact-pages.css';
import '../styles/accessibility.css';
import '../styles/footer.css';
import '../styles/atmosphere.css';
import '../styles/futuristic.css';
import signInIcon from '../assets/icons/bootstrap/box-arrow-in-right.svg?raw';
import { indexingEnabled } from '../config/site.mjs';
const signInPaths=signInIcon.trim().replace(/^<svg[^>]*>/,'').replace(/<\/svg>$/,'');
const copyrightYear=new Date().getUTCFullYear();
const { title, noindex=false, description: rawDescription = 'IN/SITU at the University of Illinois Urbana-Champaign. People, technology, and experience in context.' } = Astro.props;
const flatDescription=rawDescription.replace(/\s+/g,' ').trim();
const description=flatDescription.length>160?`${flatDescription.slice(0,157).replace(/\s+\S*$/,'')}…`:flatDescription;
const canonical=new URL(Astro.url.pathname,Astro.site);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <script is:inline set:html={preferencesBootstrap} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} | IN/SITU</title>
    <meta name="description" content={description} />
    {(!indexingEnabled||noindex||import.meta.env.DEV) && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={`${title} | IN/SITU`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
  </head>
  <body>
    <svg width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false"><defs><linearGradient id="ig" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#7c9cff"/><stop offset="1" stop-color="#5eead4"/></linearGradient></defs></svg>
    <BackgroundIcons />
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="shell">
        <a class="wordmark" href="/" aria-label="IN/SITU home">IN<span>/</span>SITU</a>
        <SiteNavigation />
        <div class="header-tools"><NightMode /><AccessibilityEntry iconOnly /></div>
      </div>
    </header>
    <main id="main" tabindex="-1" class:list={{"home-page":Astro.props.homePage}}>
      {Astro.slots.has('hero') && <div class="home-band"><div class="shell"><slot name="hero" /></div></div>}
      <div class="shell main-content"><slot /></div>
    </main>
    <footer class="site-footer">
      <div class="shell footer-grid">
        <div class="footer-identity">
          <div class="footer-brand-row"><a class="wordmark" href="/" aria-label="IN/SITU home">IN<span>/</span>SITU</a></div>
          {(!footer.draft||import.meta.env.DEV)&&<p class="label">{footer.institution}</p>}
          <ul class="footer-social" aria-label="Contact and social media">
            <li><svg viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.2" cy="6.8" r=".9" fill="currentColor"/></svg></li>
            <li class="footer-social-mail"><LabContact icon /></li>
            <li><svg viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="4"/><path d="M8 11v6M8 7.5v.01M12 17v-6M12 13c0-3 5-3.5 5 0v4"/></svg></li>
            <li><svg viewBox="0 0 24 24"><path d="M9 19c-4 1-4-2-6-2m12 4v-3.5c0-1 .1-1.4-.5-2 2.8-.3 5.5-1.4 5.5-6a4.6 4.6 0 0 0-1.3-3.2 4.2 4.2 0 0 0-.1-3.2s-1.1-.3-3.500 1.300a12.300 12.300 0 0 0-6.200 0C6.500 2.800 5.400 3.100 5.400 3.100a4.200 4.200 0 0 0-.1 3.200A4.600 4.600 0 0 0 4 9.500c0 4.600 2.700 5.700 5.500 6-.6.600-.6 1.200-.5 2V21"/></svg></li>
            <li><svg viewBox="0 0 24 24"><rect x="2.5" y="5" width="19" height="14" rx="4"/><path d="M10 9l5 3-5 3z"/></svg></li>
            <li><svg viewBox="0 0 24 24"><path d="M4 4l16 16M20 4L4 20"/></svg></li>
            <li><svg viewBox="0 0 24 24"><path d="M2 9l10-5 10 5-10 5z"/><path d="M6 11v5c3 2.500 9 2.500 12 0v-5"/></svg></li>
          </ul>
        </div>
        <div>
          <h2 class="footer-heading">Explore</h2>
          <ul>
            <li><a href="/projects/">Projects</a></li>
            <li><a href="/publications/">Publications</a></li>
            {(!values.draft||import.meta.env.DEV)&&<li><a href="/about/#values">Lab values</a></li>}
            <li><a class="footer-login" href="/admin/"><svg viewBox="0 0 16 16" aria-hidden="true" focusable="false" set:html={signInPaths}/>Log in</a></li>
          </ul>
        </div>
        <div>
          <h2 class="footer-heading">Useful links</h2>
          <ul>
            <li><a href="/about/">About</a></li>
            <li><a href="/people/">People</a></li>
            <li><AccessibilityEntry /></li>
            <li><a href="/accessibility/">Accessibility statement</a></li>
          </ul>
        </div>
      </div>
      <div class="shell footer-bottom"><p>© {copyrightYear} IN/SITU</p>{(!footer.draft||import.meta.env.DEV)&&footer.developerName&&<p>Developed by {footer.developerName}</p>}</div>
    </footer>
    <AccessibilityPanel />
      <script>import '../scripts/atmosphere.ts';</script>
  </body>
</html>

<script>
  import {setDetailsOpen} from '../scripts/motion';
  document.querySelectorAll<HTMLDetailsElement>('details').forEach(details=>{
    const summary=details.querySelector('summary');
    summary?.addEventListener('click',event=>{event.preventDefault();void setDetailsOpen(details,(details.dataset.expanded??String(details.open))!=='true');});
  });
</script>
