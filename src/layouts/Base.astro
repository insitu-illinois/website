---
import '@fontsource/space-grotesk/latin-600';
import '@fontsource/source-sans-3/latin-400';
import '@fontsource/source-sans-3/latin-700';
import '@fontsource/source-sans-3/latin-400-italic';
import '@fontsource/ibm-plex-mono/latin-400';
import '@fontsource/ibm-plex-mono/latin-500';
import '../../design-system/styles.css';
import '../styles/base.css';
import footer from '../content/pages/footer.json';
import LabContact from '../components/LabContact.astro';
import AccessibilityEntry from '../components/AccessibilityEntry.astro';
import AccessibilityPanel from '../components/AccessibilityPanel.astro';
import preferencesBootstrap from '../scripts/preferences-init.js?raw';
import '../styles/accessibility.css';
import { indexingEnabled } from '../config/site.mjs';
import {content} from '../lib/content';
const {themes}=await content();
const { title, noindex=false, description = 'IN/SITU at the University of Illinois Urbana-Champaign. People, technology, and experience in context.' } = Astro.props;
const navigation=[['About','about'],['Projects','projects'],['Publications','publications'],['Presentations','presentations'],['Awards & funding','awards-funding'],['People','people'],['News','news'],['Join','join']];
const canonical=new URL(Astro.url.pathname,Astro.site);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <script is:inline set:html={preferencesBootstrap} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} | IN/SITU</title>
    <meta name="description" content={description} />
    {(!indexingEnabled||noindex||import.meta.env.DEV) && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={`${title} | IN/SITU`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="shell">
        <a class="wordmark" href="/" aria-label="IN/SITU home">IN<span>/</span>SITU</a>
        <nav aria-label="Main navigation">
          <ul>{navigation.map(([label,path])=><li><a href={`/${path}/`} aria-current={Astro.url.pathname.startsWith(`/${path}/`) ? 'page' : undefined}>{label}</a></li>)}</ul>
        </nav>
        <AccessibilityEntry />
      </div>
    </header>
    <main id="main" tabindex="-1">
      {Astro.slots.has('hero') && <div class="home-band"><div class="shell"><slot name="hero" /></div></div>}
      <div class="shell main-content"><slot /></div>
    </main>
    <footer class="site-footer">
      <div class="shell footer-grid">
        <div><a class="wordmark" href="/" aria-label="IN/SITU home">IN<span>/</span>SITU</a><p>People, technology,<br/>and experience in context.</p>{(!footer.draft||import.meta.env.DEV)&&<><p class="label">{footer.institution}</p><p><LabContact /></p></>}</div>
        <div><p class="label">Research themes</p><ul>{themes.map((theme:any)=><li><a href={`/themes/${theme.id}/`}>{theme.data.name}</a></li>)}</ul></div>
        <div><p class="label">The lab</p><ul><li><a href="/people/">People</a></li><li><a href="/join/">Join</a></li><li><a href="/news/">News</a></li><li><a href="/admin/">Editor sign-in</a></li><li><AccessibilityEntry /></li></ul></div>
      </div>
    </footer>
    <AccessibilityPanel />
  </body>
</html>
