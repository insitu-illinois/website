---
import '@fontsource/space-grotesk/latin-600';
import '@fontsource/source-sans-3/latin-400';
import '@fontsource/source-sans-3/latin-700';
import '@fontsource/source-sans-3/latin-400-italic';
import '@fontsource/ibm-plex-mono/latin-400';
import '@fontsource/ibm-plex-mono/latin-500';
import '../../design-system/styles.css';
import '../styles/base.css';
import footer from '../content/pages/footer.json';
import location from '../content/pages/location.json';
import LabContact from '../components/LabContact.astro';
import AccessibilityEntry from '../components/AccessibilityEntry.astro';
import AccessibilityPanel from '../components/AccessibilityPanel.astro';
import NightMode from '../components/NightMode.astro';
import SiteNavigation from '../components/SiteNavigation.astro';
import '../styles/navigation.css';
import preferencesBootstrap from '../scripts/preferences-init.js?raw';
import '../styles/accessibility.css';
import { indexingEnabled } from '../config/site.mjs';
const shortAddress=location.address.split('\n').map(line=>line.trim()).filter(Boolean)[1] || location.address;
const { title, noindex=false, description = 'IN/SITU at the University of Illinois Urbana-Champaign. People, technology, and experience in context.' } = Astro.props;
const canonical=new URL(Astro.url.pathname,Astro.site);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <script is:inline set:html={preferencesBootstrap} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} | IN/SITU</title>
    <meta name="description" content={description} />
    {(!indexingEnabled||noindex||import.meta.env.DEV) && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={`${title} | IN/SITU`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="shell">
        <a class="wordmark" href="/" aria-label="IN/SITU home">IN<span>/</span>SITU</a>
        <SiteNavigation />
        <div class="header-tools"><NightMode /><AccessibilityEntry iconOnly /></div>
      </div>
    </header>
    <main id="main" tabindex="-1" class:list={{"home-page":Astro.props.homePage}}>
      {Astro.slots.has('hero') && <div class="home-band"><div class="shell"><slot name="hero" /></div></div>}
      <div class="shell main-content"><slot /></div>
    </main>
    <footer class="site-footer">
      <div class="shell footer-grid">
        <div class="footer-identity">
          <a class="wordmark" href="/" aria-label="IN/SITU home">IN<span>/</span>SITU</a>
          {(!footer.draft||import.meta.env.DEV)&&<p class="label">{footer.institution}</p>}
        </div>
        <div>
          <h2 class="footer-heading">Connect</h2>
          <ul>
            <li><LabContact /></li>
            {(!location.draft||import.meta.env.DEV)&&<li><a href="/join/#location">{shortAddress}</a></li>}
          </ul>
        </div>
        <div>
          <h2 class="footer-heading">Useful links</h2>
          <ul>
            <li><a href="/about/">About</a></li>
            <li><a href="/people/">People</a></li>
            <li><AccessibilityEntry /></li>
            <li><a class="footer-editor" href="/admin/">Sign in</a></li>
          </ul>
        </div>
      </div>
    </footer>
    <AccessibilityPanel />
  </body>
</html>
