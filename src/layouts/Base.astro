---
import '@fontsource/space-grotesk/latin-400';
import '@fontsource/space-grotesk/latin-500';
import '@fontsource/space-grotesk/latin-600';
import '@fontsource/source-sans-3/latin-400';
import '@fontsource/source-sans-3/latin-700';
import '@fontsource/source-sans-3/latin-400-italic';
import '../../design-system/styles.css';
import '../styles/base.css';
import AccessibilityPanel from '../components/AccessibilityPanel.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import BackgroundIcons from '../components/BackgroundIcons.astro';
import '../styles/play.css';
import '../styles/navigation.css';
import preferencesBootstrap from '../scripts/preferences-init.js?raw';
import '../styles/motion.css';
import '../styles/compact-pages.css';
import '../styles/accessibility.css';
import '../styles/footer.css';
import '../styles/atmosphere.css';
import '../styles/futuristic.css';
import { indexingEnabled } from '../config/site.mjs';
const { title, noindex=false, description: rawDescription = 'IN/SITU at the University of Illinois Urbana-Champaign. People, technology, and experience in context.' } = Astro.props;
const flatDescription=rawDescription.replace(/\s+/g,' ').trim();
const description=flatDescription.length>160?`${flatDescription.slice(0,157).replace(/\s+\S*$/,'')}…`:flatDescription;
const canonical=new URL(Astro.url.pathname,Astro.site);
const ogImage=new URL('/og-image.png',Astro.site).href;
const structuredData=Astro.props.homePage?JSON.stringify({'@context':'https://schema.org','@graph':[
  {'@type':'Organization','@id':new URL('/#organization',Astro.site).href,name:'IN/SITU',alternateName:'IN/SITU research lab',url:new URL('/',Astro.site).href,image:ogImage,description:'An interdisciplinary research lab at the University of Illinois Urbana-Champaign designing immersive, game-based, and interactive experiences.',parentOrganization:{'@type':'CollegeOrUniversity',name:'University of Illinois Urbana-Champaign',url:'https://illinois.edu/'}},
  {'@type':'WebSite','@id':new URL('/#website',Astro.site).href,name:'IN/SITU',url:new URL('/',Astro.site).href,publisher:{'@id':new URL('/#organization',Astro.site).href}}
]}):null;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <script is:inline set:html={preferencesBootstrap} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} | IN/SITU</title>
    <meta name="description" content={description} />
    {(!indexingEnabled||noindex||import.meta.env.DEV) && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={`${title} | IN/SITU`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="IN/SITU" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="IN/SITU: people, technology, and experience in context. University of Illinois Urbana-Champaign." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${title} | IN/SITU`} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    {structuredData&&<script type="application/ld+json" set:html={structuredData}></script>}
  </head>
  <body>
    <svg width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false"><defs><linearGradient id="ig" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#7c9cff"/><stop offset="1" stop-color="#5eead4"/></linearGradient></defs></svg>
    <BackgroundIcons />
    <a class="skip" href="#main">Skip to content</a>
    <SiteHeader />
    <main id="main" tabindex="-1" class:list={{"home-page":Astro.props.homePage}}>
      {Astro.slots.has('hero') && <div class="home-band"><div class="shell"><slot name="hero" /></div></div>}
      <div class="shell main-content"><slot /></div>
    </main>
    <SiteFooter />
    <AccessibilityPanel />
      <script>import '../scripts/atmosphere.ts'; import '../scripts/artifacts.ts';</script>
  </body>
</html>

<script>
  import {setDetailsOpen} from '../scripts/motion';
  document.querySelectorAll<HTMLDetailsElement>('details').forEach(details=>{
    const summary=details.querySelector('summary');
    summary?.addEventListener('click',event=>{event.preventDefault();void setDetailsOpen(details,(details.dataset.expanded??String(details.open))!=='true');});
  });
</script>
