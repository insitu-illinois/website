---
import Base from '../layouts/Base.astro';
import LabValues from '../components/LabValues.astro';
import RecordList from '../components/RecordList.astro';
import Media from '../components/Media.astro';
import GameCase from '../components/GameCase.astro';
import {content} from '../lib/content';
import {homeLists} from '../lib/derived.mjs';
import home from '../content/pages/home.json';
import '../styles/home.css';
const data=await content(),lists=homeLists(data);
const picturedProject=lists.projects.find((project:any)=>project.data.gallery?.length);
const researchImage=picturedProject?.data.gallery?.[0];
---
<Base homePage title="People, technology, and experience in context">
  <header slot="hero" class:list={['home-hero',{'has-research-image':researchImage}]}>
    <div class="home-introduction">
      <p class="label">An interdisciplinary research lab<br/>University of Illinois Urbana-Champaign</p>
      <h1>{(!home.draft||import.meta.env.DEV)?home.title:'People, technology, and experience in context.'}</h1>
      <p class="lead">We design immersive, game-based, and interactive experiences across archaeological sites, museums, cities, classrooms, and virtual worlds.</p>
      <div class="home-actions">
        <a class="button" href="/projects/">Explore our projects</a>
        <a class="text-link" href="/about/">About the lab</a>
        <a class="text-link" href="/people/">Meet the people</a>
      </div>
    </div>
    {researchImage&&picturedProject&&<figure class="home-research-image">
      <a href={`/projects/${picturedProject.id}/`} aria-label={`Explore ${picturedProject.data.name}`}>
        <img src={researchImage.src} alt={researchImage.alt} width="1280" height="1280" loading="eager" fetchpriority="high"/>
      </a>
      <figcaption><a href={`/projects/${picturedProject.id}/`}>{picturedProject.data.name}</a><span>{researchImage.caption}</span></figcaption>
    </figure>}
  </header>

  <section class="home-theme-section" aria-labelledby="home-themes-heading">
    <h2 id="home-themes-heading">Four research themes</h2>
    <ul class="home-themes">{data.themes.map((theme:any)=><li><a href={`/themes/${theme.id}/`}>{theme.data.name}<span aria-hidden="true">↗</span></a></li>)}</ul>
  </section>

  <section class="featured" aria-labelledby="featured-heading">
    <div class="section-heading"><div><p class="label">Featured work</p><h2 id="featured-heading">Learning in place.</h2></div><a class="text-link" href="/projects/">All projects</a></div>
    {lists.projects.map((project:any)=><article class="feature-project">
      <div class="feature-artwork">
        {project.id==='vrchaeology'&&project.data.heroMedia&&project.data.gallery?.length
          ?<GameCase cover={project.data.heroMedia} images={project.data.gallery} name={project.data.name} description={project.data.shortDescription} credits={project.data.credits||[]} creditsHref={`/projects/${project.id}/#credits-heading`} galleryHref={`/projects/${project.id}/#gallery-heading`}/>
          :<Media media={project.data.heroMedia} natural/>}
      </div>
      <div class="feature-description"><p class="label">Featured project · {project.data.status}</p><h3><a href={`/projects/${project.id}/`}>{project.data.name}</a></h3><p>{project.data.shortDescription}</p><a class="button" href={`/projects/${project.id}/`}>View project</a></div>
    </article>)}
  </section>

  <div class="home-updates">
    <RecordList compact title="Recent papers" records={lists.publications} more="/publications/"/>
    <RecordList compact title="News" records={lists.news} more="/news/"/>
  </div>
  <LabValues compact />
  <aside class="home-support"><a href="/about/#support">Support & connections</a><a href="/awards-funding/">Awards & funding</a></aside>
</Base>
