---
import Base from '../layouts/Base.astro';
import LabValues from '../components/LabValues.astro';
import ProjectShelf from '../components/ProjectShelf.astro';
import paperIcon from '../assets/icons/bootstrap/file-earmark-pdf.svg?raw';
import {dateLabel,entryUrl} from '../lib/format.mjs';
import {content} from '../lib/content';
import {homeLists} from '../lib/derived.mjs';
import home from '../content/pages/home.json';
import '../styles/home.css';
const data=await content(),lists=homeLists(data);
const shelfProjects=[...data.projects.filter((p:any)=>p.id==='vrchaeology'),...data.projects.filter((p:any)=>p.id!=='vrchaeology')].filter((p:any)=>!p.data.draft);
const updates=[...lists.news,...lists.publications.slice(0,1)].sort((a:any,b:any)=>String(b.data.date||b.data.publicationDate||b.data.year||'').localeCompare(String(a.data.date||a.data.publicationDate||a.data.year||'')));
const paperPaths=paperIcon.trim().replace(/^<svg[^>]*>/,'').replace(/<\/svg>$/,'');
---
<Base homePage title="People, technology, and experience in context">
  <header slot="hero" class="home-hero">
    <div class="home-introduction"><p class="label">University of Illinois Urbana-Champaign</p><p class="home-lab-name" aria-hidden="true">IN/SITU</p>
      {(!home.draft||import.meta.env.DEV)?<h1>{home.title.split(' ').map((word:string,i:number)=><><span class="hero-word" style={`--i:${i}`}>{word}</span>{' '}</>)}</h1>:<h1>{['People,','technology,','and','experience'].map((word,i)=><><span class="hero-word" style={`--i:${i}`}>{word}</span>{' '}</>)}<em class="hero-word" style="--i:4">in context.</em></h1>}
    </div>
    <div class="home-overview"><p class="label">An interdisciplinary research lab</p><p class="lead">We design immersive, game-based, and interactive experiences across archaeological sites, museums, cities, classrooms, and virtual worlds.</p>
      <div class="home-actions"><a class="button" href="/projects/">Explore our research <span aria-hidden="true">↗</span></a><a class="home-team-link" href="/people/">Meet the team <span aria-hidden="true">→</span></a></div>
    </div>

  </header>
  <section class="featured home-projects" aria-labelledby="home-projects-heading"><div class="section-heading"><div><p class="label">Across the lab</p><h2 id="home-projects-heading">Our projects</h2></div><a class="text-link" href="/projects/">All projects</a></div><ProjectShelf projects={shelfProjects}/></section>

  <section class="home-updates" aria-labelledby="home-updates-heading">
    <div class="section-heading"><div><p class="label">Research & lab life</p><h2 id="home-updates-heading">Latest from IN/SITU</h2></div></div>
    <ul class="home-update-grid">{updates.map((record:any)=>{const d=record.data;const visual=d.image||d.thumbnail;return <li><article class="home-update-card">
      <a class:list={["home-update-visual",{"is-publication":record.collection==='publications'}]} href={entryUrl(record)} aria-label={`Read ${d.title}`}>
        {visual?<img src={visual.src} alt={visual.alt} loading="lazy" width="480" height="320"/>:<div class="home-paper-art" aria-hidden="true"><svg viewBox="0 0 16 16" set:html={paperPaths}/><span>{d.venue}</span></div>}
      </a>
      <div class="home-update-copy"><p class="label">{record.collection==='publications'?'Publication':'News'} <span aria-hidden="true">/</span> {dateLabel(String(d.date||d.publicationDate||d.year||''))}</p><h3><a href={entryUrl(record)}>{d.title}</a></h3></div>
    </article></li>})}</ul>
    <nav class="home-update-links" aria-label="More lab updates"><a href="/news/">All news <span aria-hidden="true">→</span></a><a href="/publications/">Publications <span aria-hidden="true">→</span></a><a href="/presentations/">Presentations <span aria-hidden="true">→</span></a></nav>
  </section>
  <section class="home-theme-section"><h2>Four research themes</h2><ul class="home-themes">{data.themes.map((theme:any)=><li><a href={`/themes/${theme.id}/`}>{theme.data.name}<span aria-hidden="true">→</span></a></li>)}</ul></section>
  <LabValues compact />
  <aside class="home-support"><a href="/about/#support">Support & connections</a><a href="/awards-funding/">Awards & funding</a></aside>
</Base>
