---
import PageIntro from '../../components/PageIntro.astro';
import Base from '../../layouts/Base.astro';
import RecordList from '../../components/RecordList.astro';
import {content} from '../../lib/content';
import {newest} from '../../lib/derived.mjs';
import type { Page } from 'astro';
import type { CollectionEntry } from 'astro:content';
interface Props { page: Page<CollectionEntry<'news'>>; }
export async function getStaticPaths({paginate}:any){const data=await content();return paginate(newest(data.news),{pageSize:6});}
const {page}=Astro.props;
const data=await content();
---
<Base title={page.currentPage===1?'News':`News · Page ${page.currentPage}`} description="Updates and press coverage from IN/SITU and the VRchaeology archive.">
  <PageIntro kind="news" title="News" description="Updates from the lab, alongside stories from the VRchaeology archive."/>
  <RecordList data={data} title="Latest entries" records={page.data}/>
  {page.lastPage>1&&<nav class="pagination" aria-label="News pagination">{page.url.prev&&<a href={page.url.prev}>Newer entries</a>}<span class="label">Page {page.currentPage} of {page.lastPage}</span>{page.url.next&&<a href={page.url.next}>Older entries</a>}</nav>}
</Base>
